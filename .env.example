# Public application URL used for local links and future callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Supabase values from `npm run supabase:status`.
# The publishable key is safe to expose; authorization is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Server-only key reported as SERVICE_ROLE_KEY by `npm run supabase:status`.
# Never prefix this variable with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only salt for hashing public-write network identifiers.
PREORDER_RATE_LIMIT_SECRET=local-preorder-rate-limit-secret-change-me

# Reserved for a future server-only AI provider adapter.
AI_PROVIDER=
AI_PROVIDER_API_KEY=
