{
  "name": "smbos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-native operating system for small physical businesses",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:rls": "vitest run --config vitest.integration.config.ts tests/integration/rls.test.ts",
    "test:experience": "vitest run --config vitest.integration.config.ts tests/integration/experience.test.ts",
    "test:graph": "vitest run --config vitest.integration.config.ts tests/integration/graph.test.ts",
    "test:preorder": "vitest run --config vitest.integration.config.ts tests/integration/preorder.test.ts",
    "test:watch": "vitest",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset --local",
    "supabase:lint": "supabase db lint --local --level warning",
    "demo:seed": "node scripts/demo-seed.mjs",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.9",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.12",
    "@types/node": "24.10.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "postgres": "3.4.9",
    "prettier": "3.9.6",
    "supabase": "2.109.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7"
  }
}
